                }
              }
            }
          }
        }
      }
    },
    "录音整理之后会自动归类到会议、访谈、销售等场景。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After summarizing, recordings are sorted into scenes like meetings, interviews and sales."
          }
        }
      }
    },
    "录音整理好了、密盒连上了告诉你": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let you know when a recording is summarized or Mi Box connects"
          }
        }
      }
    },
    "录音时在舞台上实时显示文字。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show text live on the stage while recording."
