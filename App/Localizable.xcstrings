          }
        }
      }
    },
    "标记这句是谁说的": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark who said this"
          }
        }
      }
    },
    "标重点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Highlight"
          }
        }
      }
    },
    "标重点 · %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight · %lld"
          }
        }
      }
    },
    "标题": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title"
          }
        }
      }
    },
    "格外留意主诉、病史、用药、检查和医嘱；不做诊断，只记录原话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to the chief complaint, medical history, medications, tests and doctor's instructions; make no diagnosis, record what was said verbatim."
          }
        }
      }
    },
    "格外留意事实经过、时间点、各方主张、证据线索和承诺；不做法律判断，只记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to the sequence of events, times, each party's claims, evidence and commitments; make no legal judgments, just record."
          }
        }
      }
    },
    "格外留意决策、资源分配、风险、人事和需要亲自跟进的事。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to decisions, resource allocation, risks, personnel matters and things you need to follow up on personally."
          }
        }
      }
    },
    "格外留意可引用的原话、事实与来源、前后矛盾之处和值得追问的线索。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to quotable original words, facts and their sources, contradictions, and leads worth following up."
          }
        }
      }
    },
    "格外留意客户现状、痛点、假设、需要验证的数据和交付物。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to the client's current situation, pain points, hypotheses, data to be verified and deliverables."
          }
        }
      }
    },
    "格外留意客户的真实需求、预算、决策链、异议和下一步动作；金额、日期、人名要原样记下。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to the client's real needs, budget, decision chain, objections and next steps; record amounts, dates and names exactly as said."
          }
        }
      }
    },
    "格外留意用户问题、需求优先级、方案取舍、排期和负责人。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to user problems, requirement priorities, trade-offs, schedules and owners."
          }
        }
      }
    },
    "格外留意知识点、考点、老师强调的内容和作业要求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to key concepts, exam points, what the teacher emphasized, and homework requirements."
          }
        }
      }
    },
    "格外留意知识结构、例子、学员的疑问和需要补讲的地方。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to how the material is structured, examples, students' questions and points that need more explanation."
          }
        }
      }
    },
    "格外留意能做成选题的观点、可直接引用的金句、有故事性的片段和具体数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay special attention to opinions that could become topics, quotable lines, story-worthy moments and specific data."
          }
        }
      }
    },
    "检查拼接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check stitching"
          }
        }
      }
    },
    "模型": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models"
          }
        }
      }
    },
    "模型写纪要、标题、待办用的语言。之后整理的录音生效；已经整理过的可以「重新整理」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
