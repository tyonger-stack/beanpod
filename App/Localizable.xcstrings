      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequent topics"
          }
        }
      }
    },
    "平时用云端，连不上的时候自动换成本机。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the cloud normally, and switch to local automatically when it can't connect."
          }
        }
      }
    },
