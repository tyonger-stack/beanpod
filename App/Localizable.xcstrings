      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        }
      }
    },
    "录音会发给你设置的云端服务转写。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings are sent to the cloud service you set up for transcription."
          }
        }
      }
